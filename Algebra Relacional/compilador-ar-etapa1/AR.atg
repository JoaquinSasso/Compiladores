/*----------------------------------------------------------------------------
  AR.atg — Compilador de álgebra relacional a SQL (versión 1)
  Etapa 1: reconocedor. Solo acepta o rechaza la entrada; todavía no arma
  el AST, no hace chequeo semántico ni genera SQL.

  Sintaxis tomada de RelaX y de las diapositivas de Base de Datos 1:
  cada operador se puede escribir con su símbolo o con una palabra.

  IMPORTANTE: este archivo está guardado en UTF-8 con BOM, para que Coco/R
  lea bien los símbolos griegos. La entrada del compilador también tiene que
  estar en UTF-8 con BOM (Program.cs se encarga).
----------------------------------------------------------------------------*/
using System.Collections.Generic;

COMPILER AR

  // Operadores de comparación: los usa el resolver del theta-join.
  static readonly HashSet<string> opRel = new HashSet<string> {
    "=", "<>", "!=", "≠", "<", ">", "<=", ">=", "≤", "≥"
  };

  // ¿La sentencia empieza con "nombre = ..."? Mira dos tokens hacia adelante.
  bool EsAsignacion() {
    scanner.ResetPeek();
    return la.kind == _ident && scanner.Peek().val == "=";
  }

  // Después de un join: ¿lo que sigue es una condición o la relación derecha?
  //   R ⋈ a = b S        → condición (ident seguido de un comparador)
  //   R ⋈ R.a = S.b S    → condición (ident seguido de un punto)
  //   R ⋈ (a = b) S      → condición (se mira adentro del paréntesis)
  //   R ⋈ S              → relación
  //   R ⋈ (σ a = 1 S)    → relación
  bool EsCondicionJoin() {
    scanner.ResetPeek();
    Token x = la;
    while (x.val == "(") x = scanner.Peek();          // saltea paréntesis de apertura
    if (x.kind == _numero || x.kind == _cadena) return true;
    string v = x.val.ToLower();
    if (v == "not" || v == "¬" || v == "-") return true;
    if (x.kind == _ident) {
      Token sig = scanner.Peek();
      return sig.val == "." || opRel.Contains(sig.val);
    }
    return false;
  }

IGNORECASE

CHARACTERS
  letra       = 'A'..'Z' + 'a'..'z' + '_'.
  digito      = '0'..'9'.
  cr          = '\r'.
  lf          = '\n'.
  tab         = '\t'.
  noComilla   = ANY - '\'' - cr - lf.
  sinFinLinea = ANY - cr - lf.

TOKENS
  ident  = letra { letra | digito }.
  numero = digito { digito } [ '.' digito { digito } ].
  cadena = '\'' { noComilla } '\''.
  grupo  = "group:" { sinFinLinea }.          // la línea "group: Nombre del dataset"

COMMENTS FROM "--" TO lf
COMMENTS FROM "/*" TO "*/"

IGNORE cr + lf + tab

PRODUCTIONS

/*---------------------------- Programa ------------------------------------*/

AR        = [ grupo ] { Sentencia [ ";" ] } .

Sentencia = IF(EsAsignacion()) ident "=" Expr     // x = expresión
          | Expr .                                // consulta

/*----------------------- Expresiones relacionales -------------------------
  Precedencia (de menor a mayor), igual que en RelaX y en la cátedra:
    Expr   : ∪  −             (unión, diferencia)
    Inter  : ∩                (intersección)
    Prod   : ×  ⋈  *  ⟕ ⟖ ⟗  ÷ (productos, joins, división)
    Unario : π  σ  ρ  γ       (operadores unarios)
  Todos los binarios asocian a izquierda.
---------------------------------------------------------------------------*/

Expr      = Inter { OpUnion Inter } .
OpUnion   = "∪" | "union" | "-" | "except" .

Inter     = Prod { OpInter Prod } .
OpInter   = "∩" | "intersect" .

Prod      = Unario { OpProd Unario } .
OpProd    = ( "×" | "⨯" | "x" | "cross" "join" )                 // producto cartesiano
          | ( "*" | "natural" "join" )                           // natural join
          | ( "⋈" | "join" | "inner" "join" ) [ IF(EsCondicionJoin()) Cond ]       // theta-join o natural
          | ( "⟕" | "left"  [ "outer" ] "join" ) [ IF(EsCondicionJoin()) Cond ]    // join externo izquierdo
          | ( "⟖" | "right" [ "outer" ] "join" ) [ IF(EsCondicionJoin()) Cond ]    // join externo derecho
          | ( "⟗" | "full"  [ "outer" ] "join" ) [ IF(EsCondicionJoin()) Cond ]    // join externo completo
          | ( "÷" | "/" ) .                                      // división

Unario    = ( "π" | "pi" )    ListaProy Unario       // proyección
          | ( "σ" | "sigma" ) Cond      Unario       // selección
          | ( "ρ" | "rho" )   Renombre  Unario       // renombre
          | ( "γ" | "gamma" ) Agrupar   Unario       // agrupamiento
          | "(" Expr ")"
          | RelInline                                // tabla con datos
          | ident .                                  // relación o variable

/*--------------------------- Argumentos -----------------------------------*/

ListaProy = ElemProy { "," ElemProy } .
ElemProy  = Attr [ Flecha ident ] .                  // pi a, b -> nuevoNombre

Renombre  = ident [ ( FlechaIzq Attr | Flecha ident )        // ρ nuevo←viejo, ...
                    { "," ident ( FlechaIzq Attr | Flecha ident ) } ] .
                                                             // ρ S  (solo la relación)
Agrupar   = [ ListaAttr ] [ ";" ] Agregado { "," Agregado } .
Agregado  = FuncAgg "(" ( "*" | Attr ) ")" Flecha ident .    // count(*) -> cant
FuncAgg   = "count" | "sum" | "avg" | "min" | "max" .

ListaAttr = Attr { "," Attr } .
Attr      = ident [ "." ident ] .                    // nombre o Relacion.nombre
Flecha    = "→" | "->" .
FlechaIzq = "←" | "<-" .

/*--------------------------- Condiciones ----------------------------------*/

Cond      = CondY { ( "∨" | "or" ) CondY } .
CondY     = CondNo { ( "∧" | "and" ) CondNo } .
CondNo    = ( "¬" | "not" ) CondNo
          | "(" Cond ")"
          | Operando OpRel Operando .
Operando  = Attr | [ "-" ] numero | cadena .
OpRel     = "=" | "<>" | "!=" | "≠" | "<" | ">" | "<=" | ">=" | "≤" | "≥" .

/*------------------- Relación con datos (datasets) ------------------------
  materia = {
    codM, nomM, areaConoc
    1, 'Base de Datos', 'ISyBD'
  }
  Una fila nueva empieza cuando aparece un valor que no va precedido de coma.
  Que cada fila tenga tantos valores como columnas lo verifica el semántico.
---------------------------------------------------------------------------*/

RelInline = "{" Columna { "," Columna } { Fila } "}" .
Columna   = Attr [ ":" ident ] .                     // codM:number
Fila      = Valor { "," Valor } .
Valor     = [ "-" ] numero | cadena | ident .        // ident: null, true, false

END AR.
